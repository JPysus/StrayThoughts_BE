@{
    ViewData["Title"] = "Post Records";
    var isAdmin = User.IsInRole("Admin");
}

<link rel="stylesheet" href="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.css" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Post Records</h1>
    <form asp-controller="Account" asp-action="Logout" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-outline-secondary">Log out</button>
    </form>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <div class="row align-items-end mb-3">
            <div class="col-md-4">
                <label for="visibilityFilter" class="form-label">Show</label>
                <select id="visibilityFilter" class="form-select">
                    <option value="public">Public posts</option>
                    <option value="hidden">Hidden by Admin</option>
                </select>
            </div>
        </div>
        <table id="postsTable" class="table table-striped table-hover w-100">
            <thead><tr><th>Title</th><th>Created Date</th><th>Hidden Date</th><th>Actions</th></tr></thead>
        </table>
    </div>
</div>

<div class="modal fade" id="viewModal" tabindex="-1" aria-labelledby="viewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable"><div class="modal-content">
        <div class="modal-header">
            <h5 class="modal-title" id="viewModalLabel">Post details</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
            <h4 id="detailTitle"></h4>
            <div class="mb-2" id="detailBadgeEmoji"></div>
            <div class="text-muted mb-2" id="detailTheme"></div>
            <div class="text-muted" id="detailCreatedAt"></div>
            <div class="text-muted mb-3 d-none" id="detailHiddenAt"></div>
            <p id="detailBody" class="mb-0" style="white-space: pre-wrap"></p>
        </div>
        <div class="modal-footer">
            @if (isAdmin)
            {
                <button type="button" id="viewVisibilityButton" class="btn btn-danger">Hide</button>
            }
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
    </div></div>
</div>

@if (isAdmin)
{
    <div class="modal fade" id="visibilityModal" tabindex="-1" aria-labelledby="visibilityModalLabel" aria-hidden="true">
        <div class="modal-dialog"><div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="visibilityModalLabel">Confirm hide</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="visibilityModalBody">Are you sure you want to hide this post?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                <button type="button" id="confirmVisibilityButton" class="btn btn-danger">Confirm</button>
            </div>
        </div></div>
    </div>
}

@section Scripts {
    <script src="~/lib/datatables.net/dataTables.min.js"></script>
    <script src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            const isAdmin = @(isAdmin.ToString().ToLowerInvariant());
            let selectedPostId = null;
            let pendingAction = 'hide';
            let reopenViewAfterCancel = false;
            const viewModal = new bootstrap.Modal('#viewModal');
            const visibilityModal = isAdmin ? new bootstrap.Modal('#visibilityModal') : null;

            const table = $('#postsTable').DataTable({
                processing: true, serverSide: true,
                ajax: { url: '@Url.Action("DataTable", "PostsApi")', data: function (request) {
                    request.visibility = $('#visibilityFilter').val();
                }},
                order: [[1, 'desc']],
                columns: [
                    {
                        data: 'title',
                        render: function (data) {
                            var unescapedText = $('<div>').html(data).text();
                            return $('<div>').text(unescapedText).html();
                        }
                    },
                    { data: 'createdAt', render: function (data) { return new Date(data).toLocaleString(); } },
                    { data: 'adminHideDatetime', render: function (data) {
                        return data ? new Date(data).toLocaleString() : '';
                    }},
                    { data: null, orderable: false, searchable: false, render: function (data, type, row) {
                        let buttons = '<button type="button" class="btn btn-sm btn-outline-primary js-view" data-id="' + row.id + '" title="View" aria-label="View"><i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">View</span></button>';
                        if (isAdmin) {
                            const action = row.adminHideDatetime ? 'restore' : 'hide';
                            const label = row.adminHideDatetime ? 'Restore' : 'Hide';
                            const color = row.adminHideDatetime ? 'btn-outline-success' : 'btn-outline-danger';
                            const icon = row.adminHideDatetime ? 'bi-arrow-counterclockwise' : 'bi-eye-slash';
                            buttons += ' <button type="button" class="btn btn-sm ' + color + ' js-visibility" data-id="' + row.id + '" data-action="' + action + '" title="' + label + '" aria-label="' + label + '"><i class="bi ' + icon + '" aria-hidden="true"></i><span class="visually-hidden">' + label + '</span></button>';
                        }
                        return buttons;
                    }}
                ],
                columnDefs: [{ targets: 2, visible: false }]
            });

            function updateHiddenColumn() {
                table.column(2).visible($('#visibilityFilter').val() === 'hidden');
            }

            $('#visibilityFilter').on('change', function () {
                updateHiddenColumn();
                table.ajax.reload();
            });

            $('#postsTable').on('click', '.js-view', function () {
                selectedPostId = $(this).data('id');
                loadDetails(selectedPostId);
            });

            if (isAdmin) {
                $('#postsTable').on('click', '.js-visibility', function () {
                    selectedPostId = $(this).data('id');
                    pendingAction = $(this).data('action');
                    reopenViewAfterCancel = false;
                    showVisibilityConfirmation();
                });

                $('#viewVisibilityButton').on('click', function () {
                    pendingAction = $(this).data('action');
                    reopenViewAfterCancel = true;
                    viewModal.hide();
                    $('#viewModal').one('hidden.bs.modal', function () { showVisibilityConfirmation(); });
                });

                $('#visibilityModal').on('hidden.bs.modal', function () {
                    if (reopenViewAfterCancel && selectedPostId) {
                        reopenViewAfterCancel = false;
                        viewModal.show();
                    }
                });

                $('#confirmVisibilityButton').on('click', function () {
                    if (!selectedPostId) return;
                    $.ajax({
                        url: '@Url.Content("~/api/posts")/' + selectedPostId + '/' + pendingAction,
                        type: 'POST'
                    }).done(function () {
                        reopenViewAfterCancel = false;
                        visibilityModal.hide();
                        viewModal.hide();
                        table.ajax.reload(null, false);
                    }).fail(function () { alert('The post could not be updated.'); });
                });
            }

            function showVisibilityConfirmation() {
                const restoring = pendingAction === 'restore';
                $('#visibilityModalLabel').text(restoring ? 'Confirm restore' : 'Confirm hide');
                $('#visibilityModalBody').text(restoring ? 'Are you sure you want to restore this post?' : 'Are you sure you want to hide this post?');
                $('#confirmVisibilityButton').text(restoring ? 'Restore' : 'Confirm');
                visibilityModal.show();
            }

            function loadDetails(id) {
                const decode = s => $('<textarea>').html(s ?? '').text();

                $.get('@Url.Content("~/api/posts")/' + id).done(function (post) {
                    // $('#detailTitle').text(post.title);
                    // $('#detailBody').text(post.body);
                    $('#detailTitle').text(decode(post.title));
                    $('#detailBody').text(decode(post.body));
                    $('#detailBadgeEmoji').text(post.badgeEmoji ? 'Badge: ' + post.badgeEmoji : '').toggle(Boolean(post.badgeEmoji));
                    $('#detailTheme').text('Theme: ' + (post.theme?.key || ''));
                    $('#detailCreatedAt').text('Created: ' + new Date(post.createdAt).toLocaleString());
                    if (post.adminHideDatetime) {
                        $('#detailHiddenAt').text('Hidden: ' + new Date(post.adminHideDatetime).toLocaleString()).removeClass('d-none');
                    } else {
                        $('#detailHiddenAt').text('').addClass('d-none');
                    }
                    if (isAdmin) {
                        const restoring = Boolean(post.adminHideDatetime);
                        pendingAction = restoring ? 'restore' : 'hide';
                        $('#viewVisibilityButton').data('action', pendingAction).text(restoring ? 'Restore' : 'Hide');
                    }
                    viewModal.show();
                }).fail(function () { alert('The post could not be loaded.'); });
            }
        });
    </script>
}