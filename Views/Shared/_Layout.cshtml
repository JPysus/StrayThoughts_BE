@{
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StrayThoughts</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/StrayThoughts_BE.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">StrayThoughts_BE</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if(isLoggedIn)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Post</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-controller="PostAuditLogs" asp-action="Index">Post Audit Log</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Login</a>
                            </li>
                        }
                    </ul>
                    <small id="projectClock" class="text-muted ms-auto" aria-label="Current project time"></small>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Stray Thoughts Admin Side - <a asp-area="" asp-controller="Home" asp-action="About">About</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        (function () {
            const projectClock = document.getElementById('projectClock');
            const serverTimestamp = new Date('@StrayThoughts_BE.Utilities.ProjectClock.Now.ToString("yyyy-MM-ddTHH:mm:ss.fff")+08:00');
            const clientStartTimestamp = Date.now();
            const gmtPlusEight = new Intl.DateTimeFormat('en-US', {
                timeZone: 'Asia/Singapore',
                dateStyle: 'medium',
                timeStyle: 'medium'
            });

            function updateProjectClock() {
                const elapsedMilliseconds = Date.now() - clientStartTimestamp;
                const currentProjectTime = new Date(serverTimestamp.getTime() + elapsedMilliseconds);
                projectClock.textContent = 'GMT+8: ' + gmtPlusEight.format(currentProjectTime);
            }

            updateProjectClock();
            setInterval(updateProjectClock, 1000);
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
